# Required for Privy wallet connections. Public APP ID, not a secret.
# Create at https://dashboard.privy.io/
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional fallback to the official public DBK RPC:
DBK_RPC_URL=https://rpc.mainnet.dbkchain.io/
NEXT_PUBLIC_DBK_RPC_URL=https://rpc.mainnet.dbkchain.io/

# Recommended: supply a reliable Ethereum Mainnet RPC for status checks.
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
